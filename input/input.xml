<simulation verbosity="medium" safe_stride="100">
  <output prefix="/home/dealmeid/project/work/mof-heat-capacity/output/mof5-smoke">
    <properties filename="out" stride="1">[ step, time{picosecond}, conserved, potential, kinetic_cv, temperature ]</properties>
    <trajectory filename="pos" stride="1" format="pdb">positions{angstrom}</trajectory>
  </output>
  <total_steps>2</total_steps>
  <prng>
    <seed>32342</seed>
  </prng>
  <ffsocket name="lmp" mode="unix" pbc="true">
    <address>mof5-static</address>
    <latency>1e-4</latency>
  </ffsocket>
  <system>
    <initialize nbeads="1">
      <file mode="pdb" units="angstrom">/home/dealmeid/project/work/mof-heat-capacity/input/mof5.pdb</file>
      <velocities mode="thermal" units="kelvin">300</velocities>
    </initialize>
    <forces>
      <force forcefield="lmp">lmp</force>
    </forces>
    <ensemble>
      <temperature units="kelvin">300</temperature>
    </ensemble>
    <motion mode="dynamics">
      <dynamics mode="nvt">
        <thermostat mode="langevin">
          <tau units="femtosecond">100.0</tau>
        </thermostat>
        <timestep units="femtosecond">0.25</timestep>
      </dynamics>
    </motion>
  </system>
</simulation>
